OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434
COMFYUI_BASE_URL=http://127.0.0.1:8188
# ComfyUI 画像生成（SDXL Turbo 想定）。ckpt が無ければ利用可能な先頭を自動使用、無ければplaceholder。
COMFYUI_CKPT_NAME=sd_xl_turbo_1.0_fp16.safetensors
# 低速Mac向け軽量設定（1ステップ生成）。生成には数分かかるため polling は最大15分。
COMFYUI_WIDTH=384
COMFYUI_HEIGHT=672
COMFYUI_STEPS=1
COMFYUI_CFG=1.0
COMFYUI_SAMPLER=euler_ancestral
COMFYUI_SCHEDULER=normal
VIDEO_SLUG=smartphone-info
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
VIDEO_DURATION_SEC=20
ENABLE_MAC_SAY_VOICEOVER=true
# 男性の日本語音声（推奨）。無い場合は Kyoko 等へ自動フォールバック。利用可能音声: say -v '?'
MAC_SAY_VOICE=Otoya
ENABLE_WHISPER_SUBTITLES=true
