---
// 先行案内登録 / キャンペーンコード申請 共用フォーム（一般ユーザー向け）。
// 送信先：Google Apps Script（type: early_adopter）。
// 送信は text/plain;charset=utf-8 + JSON.stringify（application/json は使わない）。
//
// mode:
//  - 'early-adopter'（既定）… wants_campaign_code=false 固定。
//      完了文言=「今後の先行案内を準備が整い次第お届けします。」
//      GAS側で CampaignCodeRequests / CampaignCodeLogs には入らない。
//  - 'campaign-code' … wants_campaign_code=true 固定（チェックボックスは出さない）。
//      完了文言=「キャンペーンコードのご案内をメールでお送りします。」
//      interest_theme に「既存IQ121アプリを試したい」を追加表示。
// ※ キャンペーンコードの値は画面に一切表示しない（メール内のみ）。
import { GOOGLE_APPS_SCRIPT_URL } from '../consts';
import { withBase } from '../utils/url';

interface Props {
  mode?: 'early-adopter' | 'campaign-code';
  /** 送信payloadの wants_campaign_code を強制上書き（既定：modeから導出） */
  forceCampaignCodeRequest?: boolean;
  /** 送信payloadの source_page を固定（既定：modeから導出したURL） */
  sourcePage?: string;
}
const { mode = 'early-adopter' } = Astro.props;
const forceCampaignCodeRequest =
  Astro.props.forceCampaignCodeRequest ?? mode === 'campaign-code';
const sourcePage =
  Astro.props.sourcePage ??
  (mode === 'campaign-code' ? '/iq121-japan/campaign-code/' : '/iq121-japan/early-adopter/');
const gasUrl = GOOGLE_APPS_SCRIPT_URL;
const wantsCampaignCode = forceCampaignCodeRequest;
const doneMessage = wantsCampaignCode
  ? 'キャンペーンコードのご案内をメールでお送りします。'
  : '今後の先行案内を準備が整い次第お届けします。';
---

<form class="ff" id="ea-form" novalidate>
  <div class="ff-row">
    <label for="ea-name">お名前・ニックネーム<span class="ff-opt">任意</span></label>
    <input type="text" id="ea-name" name="name_or_nickname" autocomplete="name" />
  </div>

  <div class="ff-row">
    <label for="ea-email">メールアドレス<span class="ff-req">必須</span></label>
    <input type="email" id="ea-email" name="email" required autocomplete="email" />
  </div>

  <div class="ff-row">
    <label for="ea-theme">関心のあるテーマ<span class="ff-req">必須</span></label>
    <select id="ea-theme" name="interest_theme" required>
      <option value="">選択してください</option>
      <option>離れて暮らす親の見守り</option>
      <option>親子の安心確認</option>
      <option>家族の記録</option>
      <option>親のレシピ</option>
      <option>写真・動画の共有</option>
      <option>重要情報の整理</option>
      <option>相続・もしもの備え</option>
      <option>災害時の安否確認</option>
      <option>親との連絡習慣</option>
      {wantsCampaignCode && <option>既存IQ121アプリを試したい</option>}
      <option>その他</option>
    </select>
  </div>

  <div class="ff-row">
    <label for="ea-apart">親と離れて暮らしていますか<span class="ff-opt">任意</span></label>
    <select id="ea-apart" name="lives_apart_from_parent">
      <option value="">回答しない</option>
      <option value="yes">はい</option>
      <option value="no">いいえ</option>
      <option value="prefer_not_to_say">答えたくない</option>
    </select>
  </div>

  <div class="ff-checks">
    <label class="ff-check">
      <input type="checkbox" name="consent_prerelease_info" required />
      <span>Pre-releaseに関する情報・ご案内の受け取りに同意します。<span class="ff-req">必須</span></span>
    </label>
    <label class="ff-check">
      <input type="checkbox" name="consent_privacy_policy" required />
      <span><a href={withBase('/privacy')} target="_blank" rel="noopener">プライバシーポリシー</a>に同意します。<span class="ff-req">必須</span></span>
    </label>
    <label class="ff-check">
      <input type="checkbox" name="consent_campaign_terms" required />
      <span>キャンペーン・Pre-release提供に関する取り扱いに同意します。<span class="ff-req">必須</span></span>
    </label>
  </div>

  <!-- honeypot（人には見えない。入力があれば送信をスキップ） -->
  <div class="ff-hp" aria-hidden="true">
    <label>Webサイト<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
  </div>

  <p class="ff-error" id="ea-error" role="alert" hidden></p>
  <button type="submit" class="ff-submit" id="ea-submit">登録する</button>
</form>

<div class="ff-done" id="ea-done" hidden>
  <p class="ff-done__title">登録が完了しました。</p>
  <p id="ea-done-msg">{doneMessage}</p>
</div>

<script define:vars={{ gasUrl, wantsCampaignCode, sourcePage }}>
  const form = document.getElementById('ea-form');
  const done = document.getElementById('ea-done');
  const errBox = document.getElementById('ea-error');
  const btn = document.getElementById('ea-submit');

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errBox.hidden = true;

      const hp = form.querySelector('input[name="website"]');
      if (hp && hp.value) {
        // bot とみなし、送信せず完了扱い
        form.hidden = true;
        done.hidden = false;
        return;
      }

      if (!form.reportValidity()) return;

      const payload = {
        type: 'early_adopter',
        name_or_nickname: form.name_or_nickname.value.trim(),
        email: form.email.value.trim(),
        interest_theme: form.interest_theme.value,
        lives_apart_from_parent: form.lives_apart_from_parent.value,
        wants_campaign_code: wantsCampaignCode,
        consent_prerelease_info: form.consent_prerelease_info.checked === true,
        consent_privacy_policy: form.consent_privacy_policy.checked === true,
        consent_campaign_terms: form.consent_campaign_terms.checked === true,
        website: hp ? hp.value : '',
        source_page: sourcePage,
        user_agent: navigator.userAgent,
      };

      // 送信直前の強制上書き（GAS側の判定条件を確実に満たすための最終保証）
      payload.type = 'early_adopter';
      payload.wants_campaign_code = wantsCampaignCode === true;
      payload.source_page = sourcePage;

      // デバッグ用：payloadを確認（emailは伏せる。キャンペーンコード値は扱わない）
      console.log('[IQ121 form payload]', {
        ...payload,
        email: payload.email ? '[redacted]' : '',
        user_agent: '[ua]',
      });

      const original = btn.textContent;
      btn.disabled = true;
      btn.textContent = '送信中…';
      try {
        const res = await fetch(gasUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'text/plain;charset=utf-8' },
          body: JSON.stringify(payload),
        });
        if (!res.ok) {
          throw new Error('HTTP ' + res.status);
        }
        form.hidden = true;
        done.hidden = false;
      } catch (err) {
        errBox.textContent = '送信できませんでした。時間をおいて再度お試しください。';
        errBox.hidden = false;
        btn.disabled = false;
        btn.textContent = original;
      }
    });
  }
</script>

<style>
  .ff {
    display: grid;
    gap: 1.1rem;
    max-width: 560px;
  }
  .ff-row {
    display: grid;
    gap: 0.35rem;
  }
  .ff-row label {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-text);
  }
  .ff-req {
    margin-left: 0.5em;
    font-size: 0.7rem;
    font-weight: 700;
    color: #b4552f;
    background: #fdeee7;
    padding: 0.1em 0.5em;
    border-radius: 999px;
    vertical-align: middle;
  }
  .ff-opt {
    margin-left: 0.5em;
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--color-text-muted);
    background: var(--color-primary-light);
    padding: 0.1em 0.5em;
    border-radius: 999px;
    vertical-align: middle;
  }
  .ff input[type='text'],
  .ff input[type='email'],
  .ff select {
    width: 100%;
    box-sizing: border-box;
    padding: 0.65rem 0.8rem;
    font-size: 1rem;
    color: var(--color-text);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }
  .ff input:focus,
  .ff select:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px var(--color-primary-light);
  }
  .ff-checks {
    display: grid;
    gap: 0.7rem;
  }
  .ff-check {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.6rem;
    align-items: start;
    font-size: 0.86rem;
    line-height: 1.6;
    color: var(--color-text);
  }
  .ff-check input {
    margin-top: 0.2rem;
  }
  .ff-hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .ff-error {
    margin: 0;
    padding: 0.8rem 1rem;
    font-size: 0.86rem;
    color: #9a3412;
    background: #fdeee7;
    border: 1px solid #f3ccb8;
    border-radius: var(--radius-sm);
  }
  .ff-submit {
    justify-self: start;
    background: var(--color-primary);
    color: #fff;
    font-weight: 700;
    font-size: 1rem;
    padding: 0.8rem 2rem;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    transition: background 0.15s ease;
  }
  .ff-submit:hover:not(:disabled) {
    background: var(--color-primary-dark);
  }
  .ff-submit:disabled {
    opacity: 0.6;
    cursor: default;
  }
  .ff-done {
    padding: 1.6rem;
    background: var(--color-primary-tint);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-primary);
    border-radius: var(--radius);
    line-height: 1.8;
  }
  .ff-done__title {
    font-weight: 700;
    color: var(--color-primary-dark);
    margin: 0 0 0.3rem;
  }
  .ff-done p {
    margin: 0;
  }
</style>
