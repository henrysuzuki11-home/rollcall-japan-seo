---
// ValueCommerce 広告カード（単体）。
// - 固定データ（valueCommerceAds.ts）からのみ生成。ユーザー入力は set:html に渡さない。
// - VC の jsbanner（document.write）は使わず、同一 sid/pid の静的バナー
//   （referral リンク + gifbanner 画像）を安全に描画。
// - PR 表記／rel="nofollow sponsored noopener" + target="_blank"。
// - 公式サイトと誤認させないよう、当サイトの補足文（自作コピー）を添える。
import type { ValueCommerceAd } from '../data/valueCommerceAds';

interface Props {
  ad: ValueCommerceAd;
}
const { ad } = Astro.props;
const href = ad.clickUrl;
const banner = ad.imageUrl;
---

{
  href && (
    <div class="vcad">
      <a class="vcad__link" href={href} target="_blank" rel="nofollow sponsored noopener">
        <span class="vcad__head">
          <span class="vcad__label">{ad.disclosure}</span>
          <span class="vcad__cat">{ad.advertiserName}</span>
        </span>
        {banner && (
          <span class="vcad__imgwrap">
            <img
              class="vcad__img"
              src={banner}
              alt=""
              loading="lazy"
              decoding="async"
              referrerpolicy="no-referrer-when-downgrade"
              onerror="this.closest('.vcad__imgwrap').style.display='none'"
            />
          </span>
        )}
        <span class="vcad__title">{ad.title}</span>
        <span class="vcad__desc">{ad.description}</span>
        <span class="vcad__cta">公式サイトで確認する <span aria-hidden="true">→</span></span>
      </a>
    </div>
  )
}

<style>
  .vcad {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
    height: 100%;
  }
  .vcad:hover {
    border-color: var(--color-primary);
    box-shadow: 0 6px 18px var(--color-shadow);
  }
  .vcad__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1rem 1.1rem 1.2rem;
    color: inherit;
  }
  .vcad__link:hover {
    text-decoration: none;
  }
  .vcad__head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.7rem;
  }
  .vcad__label {
    flex: 0 0 auto;
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: #7a6a45;
    background: #f3ead3;
    border: 1px solid #e6d9b8;
    border-radius: 4px;
    padding: 0.12em 0.5em;
  }
  .vcad__cat {
    font-size: 0.72rem;
    color: var(--color-text-muted);
  }
  .vcad__imgwrap {
    display: flex;
    justify-content: center;
    align-items: center;
    background: #fafbfa;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 0.5rem;
    margin-bottom: 0.8rem;
    min-height: 72px;
    overflow: hidden;
  }
  .vcad__img {
    display: block;
    max-width: 100%;
    height: auto;
  }
  .vcad__title {
    font-weight: 700;
    font-size: 1rem;
    line-height: 1.55;
    color: var(--color-text);
    margin-bottom: 0.4rem;
  }
  .vcad__desc {
    font-size: 0.86rem;
    line-height: 1.75;
    color: var(--color-text-muted);
    margin-bottom: 1rem;
  }
  .vcad__cta {
    margin-top: auto;
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.9rem;
    font-weight: 700;
    color: #fff;
    background: var(--color-primary);
    border-radius: 8px;
    padding: 0.6rem 1.2rem;
    transition: background 0.15s ease;
  }
  .vcad:hover .vcad__cta {
    background: var(--color-primary-dark);
  }
</style>
