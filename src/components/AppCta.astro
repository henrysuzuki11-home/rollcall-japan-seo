---
// Soft in-article CTA that funnels readers to the /app landing page.
// Click is tracked via the [data-ga] delegated listener in BaseLayout.
import { withBase } from '../utils/url';

interface Props {
  heading?: string;
  text?: string;
  button?: string;
}

const {
  heading = '離れて暮らす親の安否確認に',
  text = '毎日電話しなくても、家族の安心をつくる方法があります。',
  button = 'Roll Callを見てみる',
} = Astro.props;
---

<aside class="app-cta-box" aria-label="見守りアプリの紹介">
  <div class="app-cta-box__body">
    <p class="app-cta-box__title">{heading}</p>
    <p class="app-cta-box__text">{text}</p>
  </div>
  <a
    class="app-cta-box__btn"
    href={withBase('/app')}
    data-ga="app_page_cta_click"
  >
    {button}
  </a>
</aside>

<style>
  .app-cta-box {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.3rem;
    flex-wrap: wrap;
    background: var(--color-primary-tint);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-primary);
    border-radius: var(--radius);
    padding: 1.4rem 1.6rem;
    margin: 2.5rem 0;
  }
  .app-cta-box__title {
    font-family: var(--font-serif);
    font-size: 1.12rem;
    font-weight: 700;
    color: var(--color-primary-dark);
    margin: 0 0 0.3rem;
  }
  .app-cta-box__text {
    margin: 0;
    font-size: 0.9rem;
    color: var(--color-text-muted);
    line-height: 1.8;
  }
  .app-cta-box__btn {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--color-primary);
    color: #fff;
    font-weight: 700;
    font-size: 1rem;
    padding: 0.8rem 1.6rem;
    border-radius: 8px;
    white-space: nowrap;
    transition: background 0.15s ease;
  }
  .app-cta-box__btn:hover {
    background: var(--color-primary-dark);
    text-decoration: none;
  }
  @media (max-width: 560px) {
    .app-cta-box__btn {
      width: 100%;
    }
  }
</style>
