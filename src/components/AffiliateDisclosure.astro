---
// アフィリエイト開示ラベル。商品紹介ブロックの直前（または記事冒頭）に置く。
// 文言は Creative/affiliate/affiliate_disclosure_policy.md に準拠。
interface Props {
  text?: string;
}
const {
  text = '当サイトではアフィリエイト広告を利用しています。掲載しているサービスは、必要に応じた選択肢の一つとして紹介しており、利用を強制するものではありません。サービス内容・料金・対応エリア・条件等は、必ず公式サイトでご確認ください。',
} = Astro.props;
---

<p class="aff-disclosure">{text}</p>

<style>
  .aff-disclosure {
    font-size: 0.82rem;
    color: var(--color-text-muted);
    background: var(--color-primary-tint);
    border-left: 3px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 0.7rem 1rem;
    margin: 1.2rem 0;
    line-height: 1.7;
  }
</style>
