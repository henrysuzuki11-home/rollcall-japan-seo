---
// 記事一覧のクライアントサイド検索。
// - 対象：title / description / category名 / tags（一覧ページ側で各カードに
//   data-search 属性としてまとめて埋め込む）
// - グリッド #kiji-search-grid の直下 [data-search] 要素を絞り込み
// - 件数表示・0件メッセージ対応・日本語（部分一致）想定
// 大掛かりな検索エンジンは使わない。
interface Props {
  total: number;
}
const { total } = Astro.props;
---

<div class="search" id="kiji-search">
  <label class="search-label" for="kiji-search-input">記事を検索</label>
  <input
    type="search"
    id="kiji-search-input"
    class="search-input"
    placeholder="キーワードで探す（例：安否確認、防災、アプリ）"
    autocomplete="off"
    enterkeyhint="search"
  />
  <p class="search-count" id="kiji-search-count" aria-live="polite" data-total={total}>
    全{total}件
  </p>
  <p class="search-empty" id="kiji-search-empty" hidden>
    該当する記事が見つかりませんでした。別のキーワードでお試しください。
  </p>
</div>

<script>
  const input = document.getElementById('kiji-search-input') as HTMLInputElement | null;
  const grid = document.getElementById('kiji-search-grid');
  const count = document.getElementById('kiji-search-count');
  const empty = document.getElementById('kiji-search-empty');

  if (input && grid && count) {
    const items = Array.from(grid.querySelectorAll<HTMLElement>('[data-search]'));
    const total = Number(count.getAttribute('data-total') || items.length);

    const normalize = (s: string) => s.toLowerCase().trim();

    const run = () => {
      const q = normalize(input.value);
      const terms = q.split(/\s+/).filter(Boolean);
      let shown = 0;

      for (const el of items) {
        const hay = el.getAttribute('data-search') || '';
        const match = terms.length === 0 || terms.every((t) => hay.indexOf(t) !== -1);
        el.hidden = !match;
        if (match) shown++;
      }

      if (empty) empty.hidden = shown !== 0;
      count.textContent = terms.length === 0 ? `全${total}件` : `${shown}件が該当`;
    };

    input.addEventListener('input', run);
  }
</script>

<style>
  .search {
    margin-bottom: 1.8rem;
  }
  .search-label {
    display: block;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-primary-dark);
    margin-bottom: 0.4rem;
  }
  .search-input {
    width: 100%;
    box-sizing: border-box;
    padding: 0.7rem 0.95rem;
    font-size: 1rem;
    color: var(--color-text);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }
  .search-input:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px var(--color-primary-light);
  }
  .search-count {
    margin: 0.6rem 0 0;
    font-size: 0.82rem;
    color: var(--color-text-muted);
  }
  .search-empty {
    margin: 1.5rem 0 0;
    padding: 1.2rem;
    text-align: center;
    color: var(--color-text-muted);
    background: var(--color-primary-tint);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }
</style>
