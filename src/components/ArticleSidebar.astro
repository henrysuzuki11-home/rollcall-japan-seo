---
// 記事詳細ページの補助サイドバー（PC=右、スマホ=本文下）。
// 構成順：記事検索への導線 → 人気記事 → カテゴリ一覧 → 先行案内登録CTA
//         → /app CTA → サイドバー下部広告
// 方針：本文の邪魔をしない補助的存在。CTAは広告より上。広告感は最小限。
import { CATEGORIES } from '../consts';
import { withBase } from '../utils/url';
import PopularArticles from './PopularArticles.astro';
import SidebarAd from './SidebarAd.astro';

interface Props {
  current?: string;
}
const { current } = Astro.props;
---

<aside class="side" aria-label="サイドバー">
  <!-- 記事検索への導線 -->
  <a class="side-search" href={withBase('/articles#kiji-search')}>
    <span class="side-search__icon" aria-hidden="true">🔍</span>
    記事をキーワードで探す
  </a>

  <!-- 人気記事 -->
  <PopularArticles exclude={current} />

  <!-- カテゴリ一覧 -->
  <section class="side-cats" aria-label="カテゴリー">
    <h2 class="side-h">カテゴリー</h2>
    <ul class="side-cat-list">
      {
        CATEGORIES.map((c) => (
          <li>
            <a href={withBase(`/categories/${c.slug}`)}>{c.name}</a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- 先行案内登録CTA（主・広告より上） -->
  <a class="side-cta side-cta--ea" href={withBase('/iq121-japan/early-adopter')}>
    <span class="side-cta__eyebrow">IQ121 Japan</span>
    <span class="side-cta__title">先行案内登録</span>
    <span class="side-cta__text">正式リリース前のご案内やアップデート情報をお届け予定です。</span>
  </a>

  <!-- キャンペーンコード申請（補助） -->
  <p class="side-cc-link">
    既存IQ121アプリを試したい方は<a href={withBase('/iq121-japan/campaign-code')}>こちら</a>
  </p>

  <!-- /app CTA（広告より上） -->
  <a class="side-cta side-cta--app" href={withBase('/app')} data-ga="app_page_cta_click">
    <span class="side-cta__title">見守りアプリを見る</span>
    <span class="side-cta__text">毎日電話しなくても、家族の「無事」がわかる。（無料）</span>
  </a>

  <!-- サイドバー下部広告（PCのみ・CTAより下） -->
  <SidebarAd />
</aside>

<style>
  .side {
    font-size: 0.9rem;
  }
  .side-search {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 0.7rem 0.9rem;
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: 1.8rem;
  }
  .side-search:hover {
    text-decoration: none;
    border-color: var(--color-primary);
    background: var(--color-primary-tint);
  }
  .side-search__icon {
    font-size: 0.9rem;
  }
  .side-h {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-primary-dark);
    margin: 0 0 0.7rem;
    padding-bottom: 0.4rem;
    border-bottom: 2px solid var(--color-primary-light);
  }
  .side-cats {
    margin-bottom: 1.8rem;
  }
  .side-cat-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .side-cat-list li {
    border-bottom: 1px solid var(--color-border);
  }
  .side-cat-list li:last-child {
    border-bottom: none;
  }
  .side-cat-list a {
    display: block;
    padding: 0.5rem 0;
    font-size: 0.86rem;
    color: var(--color-text);
  }
  .side-cat-list a:hover {
    color: var(--color-primary-dark);
  }
  .side-cta {
    display: block;
    border-radius: var(--radius-sm);
    padding: 0.95rem 1.05rem;
    margin-bottom: 1rem;
  }
  .side-cta:hover {
    text-decoration: none;
  }
  .side-cta__eyebrow {
    display: block;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--color-primary);
    margin-bottom: 0.15rem;
  }
  .side-cta__title {
    display: block;
    font-weight: 700;
    color: var(--color-primary-dark);
    margin-bottom: 0.2rem;
  }
  .side-cta__text {
    display: block;
    font-size: 0.78rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }
  .side-cta--ea {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    margin-bottom: 0.4rem;
  }
  .side-cta--ea:hover {
    border-color: var(--color-primary);
  }
  .side-cc-link {
    margin: 0 0 1rem;
    font-size: 0.78rem;
    color: var(--color-text-muted);
    text-align: right;
  }
  .side-cta--app {
    background: var(--color-primary-tint);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-primary);
  }
</style>
