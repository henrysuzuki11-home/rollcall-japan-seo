---
// A8 季節・帰省・ギフト・旅行系 広告カード。
// - カード全体・画像・CTAすべてクリック可能（1つの<a>で包む）
// - PR表記を明確に表示
// - rel="nofollow sponsored noopener" + target="_blank"（A8元コードが
//   nofollow のみでも、サイト側で sponsored noopener を必ず付与）
// - A8 成果計測ピクセル（trackingPixel）を必ず表示（リンク外・aria-hidden）
// - バナー画像は縦横比を保ったまま最大幅にフィット（トリミング・加工しない）
// - 728x90 等の横長バナーはカードを壊さないよう max-width で縮小
import type { A8SeasonalAd } from '../data/a8SeasonalAffiliateServices';
import { isWideBanner } from '../data/a8SeasonalAffiliateServices';

interface Props {
  ad: A8SeasonalAd;
}
const { ad } = Astro.props;
const wide = isWideBanner(ad);
---

<div class:list={['a8s', { 'a8s--wide': wide }]}>
  <a
    class="a8s__link"
    href={ad.url}
    target="_blank"
    rel="nofollow sponsored noopener"
  >
    <span class="a8s__head">
      <span class="a8s__label">{ad.label}</span>
      <span class="a8s__cat">{ad.subcategory}</span>
    </span>
    <span class="a8s__imgwrap">
      <img
        class="a8s__img"
        src={ad.imageUrl}
        alt=""
        width={ad.imageWidth}
        height={ad.imageHeight}
        loading="lazy"
        decoding="async"
        referrerpolicy="no-referrer-when-downgrade"
      />
    </span>
    <span class="a8s__title">{ad.title}</span>
    <span class="a8s__desc">{ad.description}</span>
    <span class="a8s__cta">{ad.cta} <span aria-hidden="true">→</span></span>
  </a>
  {/* A8 成果計測用ピクセル（クリック対象外・非表示） */}
  <img
    class="a8s__pixel"
    src={ad.trackingPixel}
    width="1"
    height="1"
    alt=""
    aria-hidden="true"
    loading="eager"
    decoding="async"
  />
</div>

<style>
  .a8s {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
    height: 100%;
  }
  .a8s:hover {
    border-color: var(--color-primary);
    box-shadow: 0 6px 18px var(--color-shadow);
  }
  .a8s__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1rem 1.1rem 1.2rem;
    color: inherit;
  }
  .a8s__link:hover {
    text-decoration: none;
  }
  .a8s__head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.7rem;
  }
  .a8s__label {
    flex: 0 0 auto;
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: #7a6a45;
    background: #f3ead3;
    border: 1px solid #e6d9b8;
    border-radius: 4px;
    padding: 0.12em 0.5em;
  }
  .a8s__cat {
    font-size: 0.72rem;
    color: var(--color-text-muted);
  }
  .a8s__imgwrap {
    display: flex;
    justify-content: center;
    align-items: center;
    background: #fafbfa;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 0.5rem;
    margin-bottom: 0.8rem;
    min-height: 88px;
    overflow: hidden;
  }
  .a8s__img {
    display: block;
    max-width: 100%;
    height: auto;
  }
  .a8s__title {
    font-weight: 700;
    font-size: 1rem;
    line-height: 1.55;
    color: var(--color-text);
    margin-bottom: 0.4rem;
  }
  .a8s__desc {
    font-size: 0.86rem;
    line-height: 1.75;
    color: var(--color-text-muted);
    margin-bottom: 1rem;
  }
  .a8s__cta {
    margin-top: auto;
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.9rem;
    font-weight: 700;
    color: #fff;
    background: var(--color-primary);
    border-radius: 8px;
    padding: 0.6rem 1.2rem;
    transition: background 0.15s ease;
  }
  .a8s:hover .a8s__cta {
    background: var(--color-primary-dark);
  }
  .a8s__pixel {
    display: block;
    width: 1px;
    height: 1px;
    border: 0;
    opacity: 0;
    position: absolute;
    pointer-events: none;
  }
  /* 728x90 等の横長バナー：はみ出さないよう幅にフィット */
  .a8s--wide .a8s__imgwrap {
    min-height: 0;
  }
  .a8s--wide .a8s__img {
    width: 100%;
    max-width: 468px;
  }
</style>
