---
// 忍者AdMax ディスプレイ広告（レイアウトから使う枠。既定＝記事下）。
// - 本番ビルド（import.meta.env.PROD）かつタグが設定されているときだけ出力。
//   dev / 未設定では一切描画しない（空枠も出さない）。
// - スタイルは global.css の .display-ad（スマホ対応・CLS対策）を共有。
// 配置ルールは Ads/strategy/*.md に従う（/app CTA・アフィリ商品カードに隣接させない）。
import { ADMAX_TAG_SRC } from '../consts';

interface Props {
  src?: string;
  label?: string;
}
const { src = ADMAX_TAG_SRC, label = '広告' } = Astro.props;
const enabled = import.meta.env.PROD && src !== '';
---

{
  enabled && (
    <aside class="display-ad" aria-label="広告">
      <span class="display-ad__label">{label}</span>
      <div class="display-ad__unit">
        <script is:inline src={src} />
      </div>
    </aside>
  )
}
