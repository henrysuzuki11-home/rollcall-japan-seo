---
import {
  APP_NAME,
  APP_TAGLINE,
  APP_DESCRIPTION,
  APP_CTA_LABEL,
  APP_CTA_IOS,
  APP_CTA_ANDROID,
  APP_IOS_URL,
  APP_ANDROID_URL,
} from '../consts';

interface Props {
  /** "full" = bordered card with description, "compact" = just the two buttons. */
  variant?: 'full' | 'compact';
  heading?: string;
}

const { variant = 'full', heading } = Astro.props;
---

{
  variant === 'full' ? (
    <section class="app-cta" aria-label="安否確認アプリの紹介">
      <p class="app-eyebrow">編集部が使っている見守りアプリ</p>
      <h2 class="app-name">{heading ?? APP_CTA_LABEL}</h2>
      <p class="app-tagline">{APP_TAGLINE}</p>
      <p class="app-desc">{APP_DESCRIPTION}</p>
      <div class="store-buttons">
        <a
          class="store-btn"
          href={APP_IOS_URL}
          target="_blank"
          rel="noopener noreferrer"
          data-ga="app_store_click"
        >
          {APP_CTA_IOS}
        </a>
        <a
          class="store-btn"
          href={APP_ANDROID_URL}
          target="_blank"
          rel="noopener noreferrer"
          data-ga="google_play_click"
        >
          {APP_CTA_ANDROID}
        </a>
      </div>
      <p class="app-note">
        {APP_NAME}／ダウンロード・利用は無料です
      </p>
    </section>
  ) : (
    <div class="store-buttons store-buttons--compact">
      <a
        class="store-btn"
        href={APP_IOS_URL}
        target="_blank"
        rel="noopener noreferrer"
        data-ga="app_store_click"
      >
        {APP_CTA_IOS}
      </a>
      <a
        class="store-btn"
        href={APP_ANDROID_URL}
        target="_blank"
        rel="noopener noreferrer"
        data-ga="google_play_click"
      >
        {APP_CTA_ANDROID}
      </a>
    </div>
  )
}

<style>
  .app-cta {
    background: var(--color-primary-tint);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 2rem 1.6rem;
    margin: 2.5rem 0;
    text-align: center;
  }
  .app-eyebrow {
    margin: 0 0 0.4rem;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-primary);
    letter-spacing: 0.04em;
  }
  .app-name {
    font-family: var(--font-serif);
    font-size: 1.3rem;
    margin: 0 0 0.5rem;
    color: var(--color-primary-dark);
    border: none;
    padding: 0;
    line-height: 1.5;
  }
  .app-tagline {
    font-weight: 700;
    margin: 0 0 0.9rem;
    color: var(--color-text);
  }
  .app-desc {
    font-size: 0.92rem;
    line-height: 1.85;
    color: var(--color-text-muted);
    margin: 0 auto 1.5rem;
    max-width: 560px;
  }
  .store-buttons {
    display: flex;
    gap: 0.8rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  .store-buttons--compact {
    margin: 1.5rem 0;
  }
  .store-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 170px;
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    background: var(--color-primary);
    color: #fff;
    font-weight: 700;
    font-size: 0.98rem;
    transition: background 0.15s ease;
  }
  .store-btn:hover {
    background: var(--color-primary-dark);
    text-decoration: none;
  }
  .app-note {
    margin: 1.1rem 0 0;
    font-size: 0.78rem;
    color: var(--color-text-muted);
  }
</style>
