---
// アフィリエイト・サービス広告カード（A8.net）。
// - カード全体・画像・CTAすべてクリック可能（1つの<a>で包む）
// - PR表記を明確に表示
// - rel="nofollow sponsored noopener" + target="_blank"
// - A8 1x1 トラッキング画像を必ず表示（リンクの外・aria-hidden）
// - バナー画像は縦横比を保ったまま最大幅にフィット（トリミングしない）
import type { AffiliateService } from '../data/affiliateServices';

interface Props {
  service: AffiliateService;
  /** サイドバー用のコンパクト表示（画像を小さく） */
  compact?: boolean;
}
const { service, compact = false } = Astro.props;
---

<div class:list={['asvc', { 'asvc--compact': compact }]}>
  <a
    class="asvc__link"
    href={service.url}
    target="_blank"
    rel="nofollow sponsored noopener"
  >
    <span class="asvc__head">
      <span class="asvc__label">{service.label}</span>
      <span class="asvc__cat">{service.category}</span>
    </span>
    <span class="asvc__imgwrap">
      <img
        class="asvc__img"
        src={service.imageUrl}
        alt=""
        loading="lazy"
        decoding="async"
        referrerpolicy="no-referrer-when-downgrade"
      />
    </span>
    <span class="asvc__title">{service.title}</span>
    <span class="asvc__desc">{service.description}</span>
    <span class="asvc__cta">{service.cta} <span aria-hidden="true">→</span></span>
  </a>
  {/* A8 トラッキング用 1x1 画像（クリック対象外） */}
  <img
    class="asvc__pixel"
    src={service.trackingPixel}
    width="1"
    height="1"
    alt=""
    aria-hidden="true"
    loading="eager"
    decoding="async"
  />
</div>

<style>
  .asvc {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
    height: 100%;
  }
  .asvc:hover {
    border-color: var(--color-primary);
    box-shadow: 0 6px 18px var(--color-shadow);
  }
  .asvc__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1rem 1.1rem 1.2rem;
    color: inherit;
  }
  .asvc__link:hover {
    text-decoration: none;
  }
  .asvc__head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.7rem;
  }
  .asvc__label {
    flex: 0 0 auto;
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: #7a6a45;
    background: #f3ead3;
    border: 1px solid #e6d9b8;
    border-radius: 4px;
    padding: 0.12em 0.5em;
  }
  .asvc__cat {
    font-size: 0.72rem;
    color: var(--color-text-muted);
  }
  .asvc__imgwrap {
    display: flex;
    justify-content: center;
    align-items: center;
    background: #fafbfa;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 0.5rem;
    margin-bottom: 0.8rem;
    min-height: 88px;
    overflow: hidden;
  }
  .asvc__img {
    display: block;
    max-width: 100%;
    height: auto;
  }
  .asvc__title {
    font-weight: 700;
    font-size: 1rem;
    line-height: 1.55;
    color: var(--color-text);
    margin-bottom: 0.4rem;
  }
  .asvc__desc {
    font-size: 0.86rem;
    line-height: 1.75;
    color: var(--color-text-muted);
    margin-bottom: 1rem;
  }
  .asvc__cta {
    margin-top: auto;
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.9rem;
    font-weight: 700;
    color: #fff;
    background: var(--color-primary);
    border-radius: 8px;
    padding: 0.6rem 1.2rem;
    transition: background 0.15s ease;
  }
  .asvc:hover .asvc__cta {
    background: var(--color-primary-dark);
  }
  .asvc__pixel {
    display: block;
    width: 1px;
    height: 1px;
    border: 0;
    opacity: 0;
    position: absolute;
    pointer-events: none;
  }
  /* サイドバー向けコンパクト */
  .asvc--compact .asvc__link {
    padding: 0.8rem 0.9rem 0.9rem;
  }
  .asvc--compact .asvc__imgwrap {
    min-height: 60px;
  }
  .asvc--compact .asvc__title {
    font-size: 0.9rem;
  }
  .asvc--compact .asvc__desc {
    font-size: 0.8rem;
    margin-bottom: 0.7rem;
  }
  .asvc--compact .asvc__cta {
    font-size: 0.82rem;
    padding: 0.5rem 0.9rem;
  }
</style>
