---
import type { CollectionEntry } from 'astro:content';
import { getCategory } from '../consts';
import { withBase } from '../utils/url';
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import AppCta from '../components/AppCta.astro';
import RelatedArticles from '../components/RelatedArticles.astro';
import AdSlot from '../components/AdSlot.astro';
import DisplayAd from '../components/DisplayAd.astro';
import ArticleSidebar from '../components/ArticleSidebar.astro';
import IQ121AppCTA from '../components/IQ121AppCTA.astro';
import AffiliateServiceGrid from '../components/AffiliateServiceGrid.astro';
import ValueCommerceAdGrid from '../components/ValueCommerceAdGrid.astro';

interface Props {
  article: CollectionEntry<'articles'>;
}
const { article } = Astro.props;
const { title, description, category, pubDate, updatedDate, author, tags, heroImage, faq, affiliateServices, valueCommerceAds } =
  article.data;
const cat = getCategory(category);
const hasAffiliate = affiliateServices.length > 0 || valueCommerceAds.length > 0;
// 「整理に困った時の選択肢」サイドバーは整理系（important-info）記事のみ。
// 防災記事は本文カードのみ（整理サービスのサイドバーは出さない）。
const showAffiliateSidebar = hasAffiliate && category === 'important-info';

// FAQ構造化データ（frontmatterのfaqが設定されている記事のみ出力）
const faqJsonLd =
  faq.length > 0
    ? JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faq.map((item) => ({
          '@type': 'Question',
          name: item.q,
          acceptedAnswer: { '@type': 'Answer', text: item.a },
        })),
      })
    : null;

// 記事下CTAの出し分け：
//  - レシピ・家族の記録系 → IQ121（家族の記録）CTA
//  - 重要情報・親子の安心確認系 → IQ121（重要情報）CTA
//  - それ以外 → Roll Call（毎日の安否確認）CTA
const iqRecipeCats = ['oya-recipe', 'family-record'];
const iqInfoCats = ['important-info', 'oyako-anshin', 'family-security'];
const ctaKind = iqRecipeCats.includes(category)
  ? 'iq-recipe'
  : iqInfoCats.includes(category)
    ? 'iq-info'
    : 'rollcall';

const dateStr = pubDate.toLocaleDateString('ja-JP', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const updatedStr = updatedDate?.toLocaleDateString('ja-JP', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const breadcrumbs = [
  { name: 'ホーム', url: '/' },
  { name: '記事一覧', url: '/articles' },
  ...(cat ? [{ name: cat.name, url: `/categories/${cat.slug}` }] : []),
  { name: title, url: `/articles/${article.slug}` },
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={`/articles/${article.slug}`}
  ogType="article"
  image={heroImage}
  publishDate={pubDate}
  modifiedDate={updatedDate}
  structuredDataType="article"
  breadcrumbs={breadcrumbs}
>
  {faqJsonLd && <script type="application/ld+json" set:html={faqJsonLd} />}
  <div class="container">
    <Breadcrumbs crumbs={breadcrumbs} />

    <div class="article-layout">
      <div class="article-main">
        <article class="article">
      {
        heroImage && (
          <img
            class="article-hero"
            src={withBase(heroImage)}
            alt=""
            width="1200"
            height="675"
            loading="eager"
            decoding="async"
          />
        )
      }
      <header class="article-header">
        {
          cat && (
            <a href={withBase(`/categories/${cat.slug}`)} class="article-cat">
              {cat.name}
            </a>
          )
        }
        <h1 class="article-title visually-balanced">{title}</h1>
        <p class="article-lead">{description}</p>
        <div class="article-meta">
          <span>{author}</span>
          <span>・</span>
          <time datetime={pubDate.toISOString()}>公開 {dateStr}</time>
          {updatedStr && <span>・更新 {updatedStr}</span>}
        </div>
      </header>

      <div class="prose article-body">
        <slot />
      </div>

      {
        tags.length > 0 && (
          <ul class="article-tags" aria-label="タグ">
            {tags.map((t) => (
              <li>#{t}</li>
            ))}
          </ul>
        )
      }
    </article>

        <div class="prose">
          <AdSlot label="スポンサーリンク" />
          {/* 整理アフィリエイト記事では大きなIQ121 CTAは出さず、広告カードを記事下に。
              防災記事のRoll Call（連絡の備え）CTAは本線として残す。 */}
          {!hasAffiliate && ctaKind === 'iq-recipe' && <IQ121AppCTA variant="recipe" />}
          {!hasAffiliate && ctaKind === 'iq-info' && <IQ121AppCTA variant="info" />}
          {ctaKind === 'rollcall' && <AppCta />}
        </div>

        {
          valueCommerceAds.length > 0 && (
            <div class="prose">
              <ValueCommerceAdGrid ids={valueCommerceAds} />
            </div>
          )
        }

        {
          affiliateServices.length > 0 && (
            <div class="prose">
              <AffiliateServiceGrid
                ids={affiliateServices}
                heading={category === 'disaster' ? '備えとして知っておきたい選択肢' : undefined}
              />
            </div>
          )
        }

        <div class="prose">
          <RelatedArticles current={article} />
        </div>

        <div class="prose">
          <DisplayAd label="広告" />
        </div>
      </div>

      <aside class="article-aside">
        <ArticleSidebar current={article.slug} showAffiliate={showAffiliateSidebar} />
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .article {
    max-width: var(--maxw-prose);
    margin-inline: auto;
  }
  .article-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 2.5rem;
    align-items: start;
  }
  .article-main {
    min-width: 0;
  }
  /* サイドバー併設時は本文カラム幅に合わせる（中央寄せを解除） */
  .article-main .article,
  .article-main .prose {
    max-width: none;
    margin-inline: 0;
  }
  .article-aside {
    position: sticky;
    top: 1.5rem;
  }
  @media (max-width: 980px) {
    .article-layout {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .article-aside {
      position: static;
      margin-top: 2.5rem;
    }
  }
  .article-hero {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius);
    margin-bottom: 1.4rem;
    background: var(--color-primary-tint);
  }
  .article-header {
    margin-bottom: 2rem;
  }
  .article-cat {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-primary-dark);
    background: var(--color-primary-light);
    padding: 0.3em 0.9em;
    border-radius: 999px;
    margin-bottom: 1rem;
  }
  .article-cat:hover {
    text-decoration: none;
    background: #d3e8e2;
  }
  .article-title {
    font-size: 2rem;
    line-height: 1.45;
    margin: 0 0 0.8rem;
  }
  .article-lead {
    font-size: 1.05rem;
    color: var(--color-text-muted);
    line-height: 1.8;
    margin: 0 0 1rem;
  }
  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    font-size: 0.82rem;
    color: var(--color-text-muted);
    padding-bottom: 1.2rem;
    border-bottom: 1px solid var(--color-border);
  }
  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    list-style: none;
    padding: 1.5rem 0 0;
    margin: 2rem 0 0;
    border-top: 1px solid var(--color-border);
  }
  .article-tags li {
    font-size: 0.82rem;
    color: var(--color-primary-dark);
    background: var(--color-primary-light);
    padding: 0.3em 0.8em;
    border-radius: 999px;
  }
  @media (max-width: 600px) {
    .article-title {
      font-size: 1.55rem;
    }
  }
</style>
