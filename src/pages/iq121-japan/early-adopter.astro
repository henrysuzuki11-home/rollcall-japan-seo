---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import EarlyAdopterForm from '../../components/EarlyAdopterForm.astro';
import { IQ121_IOS_URL, IQ121_ANDROID_URL } from '../../consts';
import { withBase } from '../../utils/url';

const breadcrumbs = [
  { name: 'ホーム', url: '/' },
  { name: 'IQ121 Japan', url: '/iq121-japan' },
  { name: '先行案内登録', url: '/iq121-japan/early-adopter' },
];
---

<BaseLayout
  title="IQ121 Japan 先行案内登録"
  description="IQ121 JapanのPre-releaseに向けた先行案内登録ページです。登録いただいた方には、今後のご案内やキャンペーンコードに関する情報をお届けする予定です。離れて暮らす家族の見守りに関心のある方はこちらから。"
  canonical="/iq121-japan/early-adopter"
  breadcrumbs={breadcrumbs}
>
  <div class="container section">
    <Breadcrumbs crumbs={breadcrumbs} />

    <article class="prose ea-page">
      <p class="iq-eyebrow">IQ121 Japan / Pre-release</p>
      <h1>IQ121 Japan 先行案内登録</h1>
      <p class="iq-lead">
        IQ121 JapanのPre-releaseに向けて、先行案内登録を受け付けています。
        登録いただいた方には、今後のご案内やアップデート情報を準備が整い次第お届けする予定です。
      </p>
      <p class="ea-cc-link">
        現在リリース済みのIQ121アプリを試したい方は、キャンペーンコード申請ページをご利用ください。
        → <a href={withBase('/iq121-japan/campaign-code')}>キャンペーンコードを申請する</a>
      </p>
      <p class="ea-note">
        特典・キャンペーンの詳細は、Pre-release時にご案内予定です。
        登録は無料で、いつでも配信の停止をご依頼いただけます。
      </p>
      <p class="ea-note">
        IQ121は、AES-256による暗号化やAuthenticatorアプリ等を用いた多要素認証に対応し、
        ユーザーのプライベートな情報を開発者や運営者が直接確認できない設計を採用しています。
      </p>
      <p class="ea-applink">
        IQ121アプリは
        <a href={IQ121_IOS_URL} target="_blank" rel="noopener noreferrer" data-ga="iq121_ios_click">App Store</a>
        ・
        <a href={IQ121_ANDROID_URL} target="_blank" rel="noopener noreferrer" data-ga="iq121_android_click">Google Play</a>
        でもご確認いただけます。
      </p>
    </article>

    <div class="ea-form-wrap">
      <EarlyAdopterForm />
    </div>
  </div>
</BaseLayout>

<style>
  .section {
    padding: 2.5rem 20px 3.5rem;
  }
  .ea-page {
    max-width: var(--maxw-prose);
    margin-inline: auto;
  }
  .iq-eyebrow {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--color-primary);
    margin: 0 0 0.5rem;
  }
  .iq-lead {
    font-size: 1.02rem;
    line-height: 1.9;
    color: var(--color-text);
  }
  .ea-note {
    background: var(--color-primary-tint);
    border-left: 3px solid var(--color-primary);
    border-radius: var(--radius-sm);
    padding: 0.9rem 1.2rem;
    font-size: 0.9rem;
    color: var(--color-text);
    line-height: 1.75;
  }
  .ea-form-wrap {
    max-width: var(--maxw-prose);
    margin: 1.5rem auto 0;
  }
  .ea-applink {
    font-size: 0.86rem;
    color: var(--color-text-muted);
  }
  .ea-cc-link {
    font-size: 0.9rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 0.8rem 1.1rem;
    line-height: 1.8;
  }
</style>
