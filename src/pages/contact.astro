---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ContactForm from '../components/ContactForm.astro';
import { SITE_NAME, OPERATOR } from '../consts';
import { withBase } from '../utils/url';

const breadcrumbs = [
  { name: 'ホーム', url: '/' },
  { name: 'お問い合わせ', url: '/contact' },
];
---

<BaseLayout
  title="お問い合わせ"
  description={`${SITE_NAME}へのお問い合わせはこちらから。記事の内容に関するご意見・ご質問、掲載情報の誤りのご指摘などを、お問い合わせフォームよりお寄せください。`}
  canonical="/contact"
  breadcrumbs={breadcrumbs}
>
  <div class="container section">
    <Breadcrumbs crumbs={breadcrumbs} />
    <article class="prose contact-page">
      <h1>お問い合わせ</h1>
      <p>
        {SITE_NAME}をご覧いただき、ありがとうございます。記事の内容に関するご意見・ご質問、
        掲載情報の誤りのご指摘、アプリについてのお問い合わせなどは、下記のフォームよりお送りください。
        いただいたご意見は、今後のサイトづくりの参考にさせていただきます。
      </p>

      <h2>お問い合わせの前に</h2>
      <ul>
        <li>
          記事は一般的な情報提供を目的としています。個別の医療・介護・法律に関するご相談には
          お答えできません。専門機関へのご相談をおすすめします。
        </li>
        <li>
          内容によっては、返信までお時間をいただく場合や、返信を差し控える場合があります。
          あらかじめご了承ください。
        </li>
        <li>
          投資家・事業提携・法人連携・メディアなど、事業に関するお問い合わせは
          <a href={withBase('/iq121-japan/investor')}>IQ121 Japan 投資家・事業提携のお問い合わせ</a>
          をご利用ください。
        </li>
      </ul>
    </article>

    <div class="contact-form-wrap">
      <ContactForm />
    </div>

    <article class="prose contact-page">
      <h2>運営者</h2>
      <p>{OPERATOR}</p>
    </article>
  </div>
</BaseLayout>

<style>
  .section {
    padding: 2.5rem 20px 3.5rem;
  }
  .contact-page {
    max-width: var(--maxw-prose);
    margin-inline: auto;
  }
  .contact-form-wrap {
    max-width: var(--maxw-prose);
    margin: 1.5rem auto;
  }
</style>
