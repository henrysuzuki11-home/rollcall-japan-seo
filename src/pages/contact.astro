---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE_NAME, OPERATOR, CONTACT_EMAIL } from '../consts';

const breadcrumbs = [
  { name: 'ホーム', url: '/' },
  { name: 'お問い合わせ', url: '/contact' },
];
const mailHref = `mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent(
  '【お問い合わせ】' + SITE_NAME
)}`;
---

<BaseLayout
  title="お問い合わせ"
  description={`${SITE_NAME}へのお問い合わせはこちらから。記事の内容に関するご意見・ご質問をお寄せください。`}
  canonical="/contact"
  breadcrumbs={breadcrumbs}
>
  <div class="container">
    <Breadcrumbs crumbs={breadcrumbs} />
    <article class="prose">
      <h1>お問い合わせ</h1>
      <p>
        {SITE_NAME}をご覧いただき、ありがとうございます。記事の内容に関するご意見・ご質問、
        掲載情報の誤りのご指摘などがございましたら、下記のメールアドレスまでお気軽にご連絡ください。
        いただいたご意見は、今後のサイトづくりの参考にさせていただきます。
      </p>

      <div class="contact-card">
        <p class="contact-label">メールでのお問い合わせ</p>
        <p class="contact-mail">
          <a href={mailHref}>{CONTACT_EMAIL}</a>
        </p>
        <p class="contact-note">
          お使いのメールソフトが起動します。起動しない場合は、上記アドレス宛てに直接メールを
          お送りください。
        </p>
      </div>

      <h2>お問い合わせの前に</h2>
      <ul>
        <li>
          記事は一般的な情報提供を目的としています。個別の医療・介護・法律に関するご相談には
          お答えできません。専門機関へのご相談をおすすめします。
        </li>
        <li>
          内容によっては、返信までお時間をいただく場合や、返信を差し控える場合があります。
          あらかじめご了承ください。
        </li>
      </ul>

      <h2>運営者</h2>
      <p>{OPERATOR}</p>
    </article>
  </div>
</BaseLayout>

<style>
  .contact-card {
    background: var(--color-primary-tint);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1.5rem 1.6rem;
    margin: 1.8rem 0;
  }
  .contact-label {
    margin: 0 0 0.3rem;
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--color-primary);
  }
  .contact-mail {
    margin: 0 0 0.5rem;
    font-size: 1.2rem;
    font-weight: 700;
  }
  .contact-note {
    margin: 0;
    font-size: 0.84rem;
    color: var(--color-text-muted);
  }
</style>
