# 親みまもり研究所 環境変数サンプル
# ローカルでコピーして使う場合: cp .env.example .env

# ValueCommerce 広告の公開スイッチ。
# 既定は false（表示しない）。VC参加審査が承認済みのため、本番では true にすると表示される。
# ※ true でも、各広告の isActive=false / approvalStatus!=='approved' / clickUrl空 は非表示。
# 本番（GitHub Actions deploy.yml）では true を設定済み。
PUBLIC_ENABLE_VALUECOMMERCE_ADS=false
